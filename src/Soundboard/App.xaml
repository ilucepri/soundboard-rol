<Application x:Class="Soundboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Soundboard.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Nocturne.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <views:HexToBrushConverter x:Key="HexToBrush"/>
            <views:ProgressToStarConverter x:Key="ProgressToStar"/>
            <views:PercentConverter x:Key="Percent"/>
            <views:TextToVisibilityConverter x:Key="TextToVisibility"/>
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
