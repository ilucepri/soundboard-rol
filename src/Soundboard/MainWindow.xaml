<Window x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Soundboard.Views"
        Title="Soundboard de rol" Height="780" Width="1180" MinHeight="600" MinWidth="900"
        WindowStyle="None" Background="{StaticResource Bg}"
        AllowDrop="True" Drop="OnDropFiles" DragOver="OnDragOverFiles"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource FontBody}" Foreground="{StaticResource Text}">

    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight = alto de la barra propia: así Windows sigue dando arrastre,
             doble click para maximizar y Aero Snap sin reimplementarlos. -->
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fila de perfil de la barra lateral -->
        <Style x:Key="ProfileRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="{StaticResource CornerMd}" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Encabezado de columna de la biblioteca -->
        <Style x:Key="TableHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral600}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ 1. Barra de título ══════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Chrome}">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- La misma onda del icono de la app, dibujada a mano para que escale limpia. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="15">
                        <Border Width="2" Height="5"  CornerRadius="1" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,1.5,0"/>
                        <Border Width="2" Height="9"  CornerRadius="1" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,1.5,0"/>
                        <Border Width="2" Height="14" CornerRadius="1" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,1.5,0"/>
                        <Border Width="2" Height="8"  CornerRadius="1" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,1.5,0"/>
                        <Border Width="2" Height="4"  CornerRadius="1" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Soundboard de rol" FontSize="12" FontWeight="Medium"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BtnCaption}" Click="OnMinimize" ToolTip="Minimizar">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" Click="OnToggleMaximize" ToolTip="Maximizar">
                        <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource BtnCaptionClose}" Click="OnClose" ToolTip="Cerrar">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ 2. Barra de dispositivos ══════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="14,9">
            <!-- Dos bloques que se reparten el ancho a partes iguales y el botón a tamaño fijo,
                 que es el "flex: 1 1 300px" del diseño. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Emisión: lo que Wave Link recoge y acaba en Discord. -->
                <DockPanel Grid.Column="0" Margin="0,0,10,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="EMISIÓN" Style="{StaticResource Kicker}" Width="56"/>
                    <TextBlock DockPanel.Dock="Right" Width="32" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextAlignment="Right" FontSize="11" Foreground="{StaticResource Neutral500}"
                               Text="{Binding BroadcastVolume, Converter={StaticResource Percent}}"/>
                    <Slider DockPanel.Dock="Right" Width="78" Margin="8,0,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="{Binding BroadcastVolume}"/>
                    <ComboBox Margin="8,0,0,0" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding BroadcastDevice}" DisplayMemberPath="Name"
                              ToolTip="A dónde va el sonido que oyen los demás"/>
                </DockPanel>

                <!-- Monitor: lo que oyes tú, a tu propio volumen. -->
                <DockPanel Grid.Column="1" Margin="8,0,10,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="MONITOR" Style="{StaticResource Kicker}" Width="56"/>
                    <TextBlock DockPanel.Dock="Right" Width="32" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextAlignment="Right" FontSize="11" Foreground="{StaticResource Neutral500}"
                               Text="{Binding MonitorVolume, Converter={StaticResource Percent}}"/>
                    <Slider DockPanel.Dock="Right" Width="78" Margin="8,0,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="{Binding MonitorVolume}"/>
                    <ComboBox Margin="8,0,0,0" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding MonitorDevice}" DisplayMemberPath="Name"
                              ToolTip="A dónde va el sonido que oyes tú"/>
                </DockPanel>

                <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Height="30"
                        Command="{Binding RefreshDevicesCommand}"
                        ToolTip="Volver a leer los dispositivos de Windows">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Dispositivos" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════ 3. Aviso de sin emisión ══════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource DangerSurface}" Padding="14,8"
                Visibility="{Binding NeedsBroadcastDevice, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="15"
                           Foreground="{StaticResource Danger}"/>
                <TextBlock Text="Sin salida de emisión no llega nada a Discord. Elige un canal de Wave Link arriba."
                           FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════ 4. Cuerpo ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Barra lateral de perfiles ─── -->
            <Border Grid.Column="0" Background="{StaticResource Chrome}">
                <DockPanel Margin="8,12">
                    <Grid DockPanel.Dock="Top" Margin="9,0,0,8">
                        <TextBlock Text="PERFILES" Style="{StaticResource Kicker}"/>
                        <Button Style="{StaticResource BtnIconSmall}" HorizontalAlignment="Right"
                                Command="{Binding AddProfileCommand}" ToolTip="Crear un perfil nuevo">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!-- Pie: entrada a la biblioteca -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Style="{StaticResource BtnBase}" HorizontalContentAlignment="Left"
                                Padding="9,7" Command="{Binding ShowLibraryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="16"
                                           Foreground="{StaticResource Neutral400}" Width="20"/>
                                <TextBlock Text="Biblioteca" Margin="9,0,0,0"
                                           Foreground="{StaticResource Neutral400}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             ItemContainerStyle="{StaticResource ProfileRow}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Renombrar / icono…"
                                                      Command="{Binding PlacementTarget.Tag.EditProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="15"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Duplicar perfil"
                                                      Command="{Binding PlacementTarget.Tag.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="15"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Borrar perfil" Foreground="{StaticResource Danger}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15"
                                                               Foreground="{StaticResource Danger}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" Margin="9,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PadCount}" FontSize="10.5"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource Neutral600}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─── Panel principal ─── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ····· Vista Tablero ····· -->
                <DockPanel Grid.Row="0" Visibility="{Binding IsBoardView, Converter={StaticResource BoolToVisibility}}">
                    <Grid DockPanel.Dock="Top" Margin="18,14,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding SelectedProfile.Icon}" FontSize="19"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.Name}" Style="{StaticResource Heading}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BoardSubtitle}" Style="{StaticResource Muted}"
                                   Margin="10,0,10,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Border Width="176" Height="32" CornerRadius="{StaticResource CornerMd}"
                                    BorderBrush="{StaticResource Divider}" BorderThickness="1">
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE721;"
                                               FontSize="14" Foreground="{StaticResource Neutral600}"/>
                                    <Grid Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="Buscar" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Neutral600}" IsHitTestVisible="False"
                                                   Visibility="{Binding SearchText, Converter={StaticResource TextToVisibility}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 MinHeight="0" FontSize="13" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource BtnSecondary}" Height="32" Margin="8,0,0,0"
                                    Command="{Binding AddSoundsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13"
                                               Foreground="{StaticResource Text}"/>
                                    <TextBlock Text="Añadir sonidos" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="18,4,18,18">
                        <Grid>
                            <!-- Estado vacío: perfil sin sonidos, o búsqueda sin resultados -->
                            <StackPanel Margin="0,64,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding VisiblePads.Count, Converter={StaticResource EmptyToVisibility}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="34"
                                           Foreground="{StaticResource Neutral600}"/>
                                <TextBlock Text="Este perfil no tiene sonidos todavía." FontSize="13.5"
                                           Foreground="{StaticResource Neutral600}" Margin="0,14,0,0"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Arrastra ficheros aquí o usa «Añadir sonidos»." FontSize="13.5"
                                           Foreground="{StaticResource Neutral600}" Margin="0,4,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding VisiblePads}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <views:PadPanel MinItemWidth="166" ItemHeight="112" Spacing="9"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- El pad: fondo = su color al 16 %, nunca el tono plano. -->
                                        <!-- El tamaño lo reparte PadPanel; aquí sólo el aspecto. -->
                                        <Border CornerRadius="{StaticResource CornerMd}"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=0.16}"
                                                BorderBrush="{StaticResource Neutral800}" BorderThickness="1"
                                                Cursor="Hand" MouseLeftButtonUp="OnPadClick"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Editar sonido…"
                                                              Command="{Binding PlacementTarget.Tag.EditPadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="15"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Reproducir en bucle" IsCheckable="True"
                                                              IsChecked="{Binding Loop, Mode=TwoWay}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EE;" FontSize="15"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Abrir ubicación"
                                                              Command="{Binding PlacementTarget.Tag.RevealPadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="15"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Quitar del perfil" Foreground="{StaticResource Danger}"
                                                              Command="{Binding PlacementTarget.Tag.RemovePadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15"
                                                                       Foreground="{StaticResource Danger}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid Margin="11,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="18"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Fila superior: punto de estado, bucle y tecla -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" Opacity="0.34"
                                                                 Fill="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                                        <TextBlock x:Name="LoopMark" Style="{StaticResource Icon}"
                                                                   Text="&#xE8EE;" FontSize="13" Opacity="0"
                                                                   Margin="6,0,0,0" Foreground="{StaticResource Neutral400}"/>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            CornerRadius="{StaticResource CornerSm}" Padding="4,0"
                                                            BorderBrush="{StaticResource Divider}" BorderThickness="1"
                                                            Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Shortcut}" FontSize="10"
                                                                   Foreground="{StaticResource Neutral400}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Nombre, dos líneas como mucho -->
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14"
                                                           FontWeight="Medium" Margin="0,8,0,0" LineHeight="17.5"
                                                           TextWrapping="Wrap" MaxHeight="36"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>

                                                <!-- Volumen del pad: sus clicks no deben disparar el sonido -->
                                                <Grid Grid.Row="2" Background="Transparent"
                                                      MouseLeftButtonUp="OnSwallowClick"
                                                      MouseLeftButtonDown="OnSwallowClick">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource Icon}"
                                                               Text="&#xE767;" FontSize="13"
                                                               Foreground="{StaticResource Neutral500}"/>
                                                    <Slider Grid.Column="1" Margin="6,0,0,0" Minimum="0" Maximum="1"
                                                            Value="{Binding Volume}" ToolTip="Volumen de este sonido"/>
                                                </Grid>

                                                <!-- Barra de progreso pegada al borde inferior -->
                                                <Grid Grid.Row="2" Height="2" VerticalAlignment="Bottom"
                                                      Margin="-11,0,-11,-10" IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressToStar}}"/>
                                                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressToStar}, ConverterParameter=Rest}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Grid>

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Neutral700}"/>
                                                            <Setter Property="Effect" Value="{StaticResource ShadowMd}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Loop}" Value="True">
                                                <Setter TargetName="LoopMark" Property="Opacity" Value="0.9"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ····· Vista Biblioteca ····· -->
                <DockPanel Grid.Row="0" Visibility="{Binding IsLibraryView, Converter={StaticResource BoolToVisibility}}">
                    <Grid DockPanel.Dock="Top" Margin="18,14,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Biblioteca" Style="{StaticResource Heading}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Ficheros conocidos · se guarda la ruta, no una copia"
                                   Style="{StaticResource Muted}" Margin="10,0,10,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Height="32"
                                Command="{Binding ShowBoardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13"
                                           Foreground="{StaticResource Text}"/>
                                <TextBlock Text="Volver al tablero" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,18,18">
                        <StackPanel>
                            <!-- Zona de soltar -->
                            <Grid Margin="0,0,0,14">
                                <Rectangle RadiusX="8" RadiusY="8" Stroke="{StaticResource Neutral800}"
                                           StrokeThickness="1" StrokeDashArray="4 3"/>
                                <StackPanel Margin="22" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="18"
                                               Foreground="{StaticResource Neutral500}"/>
                                    <TextBlock Text="Arrastra WAV o MP3 aquí — M4A, AAC, WMA y FLAC vía Media Foundation"
                                               FontSize="13" Foreground="{StaticResource Neutral500}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Cabecera de tabla -->
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FICHERO" Style="{StaticResource TableHead}"/>
                                <TextBlock Grid.Column="1" Text="DURACIÓN" Style="{StaticResource TableHead}"/>
                                <TextBlock Grid.Column="2" Text="PERFILES QUE LO USAN" Style="{StaticResource TableHead}"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,2"/>

                            <ItemsControl ItemsSource="{Binding LibraryEntries}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,7" Background="Transparent"
                                                BorderBrush="{StaticResource HoverMenu}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Directory}" FontSize="11"
                                                               Foreground="{StaticResource Neutral600}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="13"
                                                           Foreground="{StaticResource Neutral400}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding UsedByText}" FontSize="12"
                                                           Foreground="{StaticResource Neutral500}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0"/>
                                                <Button Grid.Column="3" Content="Añadir" HorizontalAlignment="Right"
                                                        Style="{StaticResource BtnGhost}"
                                                        Command="{Binding DataContext.AddFromLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Todavía no hay ficheros en ningún perfil."
                                       FontSize="13.5" Foreground="{StaticResource Neutral600}"
                                       HorizontalAlignment="Center" Margin="0,40,0,0"
                                       Visibility="{Binding LibraryEntries.Count, Converter={StaticResource EmptyToVisibility}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ══════════════════ 5. Barra de estado ══════════════════ -->
                <Border Grid.Row="1" Background="{StaticResource Chrome}" Padding="18,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12"
                                   Foreground="{StaticResource Neutral400}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding PlayingLabel}" FontSize="11.5"
                                   Foreground="{StaticResource Neutral600}" VerticalAlignment="Center"
                                   Margin="12,0"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnPrimary}"
                                Command="{Binding StopAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="Parar todo" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
