<Window x:Class="Soundboard.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Width="400" Title="Perfil">

    <Window.Resources>
        <!-- Cada emoji es una casilla de 36 × 36; la elegida lleva el anillo de acento por dentro. -->
        <Style x:Key="IconCell" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Width="36" Height="36" CornerRadius="{StaticResource CornerMd}"
                                Background="Transparent" BorderBrush="{StaticResource Divider}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CornerLg}"
            BorderBrush="{StaticResource Neutral500}" BorderThickness="1" Padding="19">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Heading}" Text="Perfil"/>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Nombre" FontSize="12" Foreground="{StaticResource Neutral400}" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" KeyDown="OnKeyDown"/>
                <TextBlock Text="Bardo, Taberna, Combate…" Style="{StaticResource Muted}" Margin="2,5,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Icono" FontSize="12" Foreground="{StaticResource Neutral400}" Margin="0,0,0,5"/>
                <ListBox x:Name="IconList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource IconCell}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="17"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancelar" MinWidth="88" Style="{StaticResource BtnSecondary}" Click="OnCancel"/>
                <Button Content="Guardar" MinWidth="88" Margin="6,0,0,0"
                        Style="{StaticResource BtnPrimary}" Click="OnAccept" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
