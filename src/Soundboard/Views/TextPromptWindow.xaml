<Window x:Class="Soundboard.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Surface}">
    <Border Padding="20" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="LabelText" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBox x:Name="Input" KeyDown="OnInputKeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" MinWidth="90" Click="OnCancel"/>
                <Button Content="Aceptar" MinWidth="90" Margin="8,0,0,0"
                        Style="{StaticResource AccentButton}" Click="OnAccept"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
