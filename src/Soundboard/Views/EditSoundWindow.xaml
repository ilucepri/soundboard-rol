<Window x:Class="Soundboard.Views.EditSoundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Width="500" Title="Editar sonido">

    <Window.Resources>
        <!-- Muestra de color: el anillo de selección va por fuera, a 3 px de separación. -->
        <Style x:Key="Swatch" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" CornerRadius="8" Padding="3" BorderThickness="1.5"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource HoverSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Neutral400}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CornerLg}"
            BorderBrush="{StaticResource Neutral500}" BorderThickness="1" Padding="19">
        <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="Editar sonido"/>
            <TextBlock x:Name="PathText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0"/>

            <!-- Nombre y atajo -->
            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Atajo" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ShortcutBox" TextAlignment="Center" MaxLength="1"
                             TextChanged="OnShortcutChanged"/>
                </StackPanel>
            </Grid>

            <!-- Recorte -->
            <StackPanel Margin="0,15,0,0">
                <TextBlock x:Name="TrimLabel" Style="{StaticResource FieldLabel}" Text="Recorte"/>
                <Border Height="56" Background="{StaticResource Bg}" CornerRadius="{StaticResource CornerSm}"
                        Padding="4,2">
                    <primitives:UniformGrid x:Name="Waveform" Rows="1"/>
                </Border>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="TrimStartSlider" Grid.Column="0" Margin="0,0,8,0"
                            Minimum="0" Maximum="0.6" ValueChanged="OnTrimChanged"/>
                    <Slider x:Name="TrimEndSlider" Grid.Column="1" Margin="8,0,0,0"
                            Minimum="0.4" Maximum="1" ValueChanged="OnTrimChanged"/>
                </Grid>
            </StackPanel>

            <!-- Volumen -->
            <StackPanel Margin="0,15,0,0">
                <TextBlock x:Name="VolumeLabel" Style="{StaticResource FieldLabel}" Text="Volumen"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" ValueChanged="OnVolumeChanged"/>
            </StackPanel>

            <!-- Color -->
            <StackPanel Margin="0,15,0,0">
                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                <ListBox x:Name="ColorList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource Swatch}" SelectionChanged="OnColorChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="22" Height="22" CornerRadius="5"
                                    Background="{Binding Converter={StaticResource HexToBrush}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Bucle -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <CheckBox x:Name="LoopCheck" Content="Reproducir en bucle"/>
                <TextBlock Text="— para música de ambiente" Style="{StaticResource Muted}" FontSize="13"
                           VerticalAlignment="Center" Margin="7,0,0,0"/>
            </StackPanel>

            <!-- Acciones -->
            <Grid Margin="0,19,0,0">
                <Button Content="Quitar del perfil" HorizontalAlignment="Left"
                        Style="{StaticResource BtnGhostDanger}" Click="OnRemove"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" MinWidth="88" Style="{StaticResource BtnSecondary}" Click="OnCancel"/>
                    <Button Content="Guardar" MinWidth="88" Margin="6,0,0,0"
                            Style="{StaticResource BtnPrimary}" Click="OnAccept" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
